{
  "name": "Asterisk Click to Call",
  "version": "1.0.3",
  "author": "RussH",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "Click to call – calls any phone number you've highlighted or in tel:/callto: links directly from your browser using Asterisk. Open Source, NEVER shares your call information.",
  "icons": {
    "16": "phone16.png",
    "48": "phone48.png",
    "128": "phone128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "phone16.png",
      "48": "phone48.png"
    },
    "default_title": "Asterisk Click to Call"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
